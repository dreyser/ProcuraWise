# Fase 27 (ADR 0004/0005/0019): imagen del worker asíncrono (dispatch table
# de jobs sobre Azure Service Bus en staging/producción, ADR 0005) para
# Azure Container Apps. Mismo build multi-stage con uv que Dockerfile.api -
# API y worker comparten el mismo paquete `procurawise` (monolito modular,
# CLAUDE.md §3), así que la etapa builder es idéntica a propósito; solo
# difieren en el comando final.

FROM python:3.13-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:0.11.29 /uv /uvx /bin/
WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

COPY procurawise ./procurawise
COPY migrations ./migrations
RUN uv sync --locked --no-dev

FROM python:3.13-slim
WORKDIR /app
RUN useradd --create-home --uid 1000 appuser
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/procurawise /app/procurawise
COPY --from=builder /app/migrations /app/migrations
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

USER appuser

# Sin puerto expuesto ni HTTP server - el worker es un loop de consumo de
# cola (run_worker_loop, shared/worker_loop.py), sin superficie de red
# propia. Container Apps lo aloja igual (misma Environment que la API) pero
# sin ingress ni probes HTTP.
CMD ["python", "-m", "procurawise.worker.main"]
