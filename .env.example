# Copiar a .env y ajustar valores locales. Nunca comitear .env con secretos reales.

# service/procurawise/shared/config.py — Settings compartida entre API y worker
ENVIRONMENT=local
LOG_LEVEL=info

# MongoDB Community local (make dev-up). Sin auth — solo válido en local, nunca expuesto.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=procurawise_local

# Azurite (Blob Storage local, make dev-up). "UseDevelopmentStorage=true" es el atajo
# público documentado por Azurite/Azure SDK para el emulador — no es una credencial real.
STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
STORAGE_CONTAINER_NAME=procurawise-local

# Versión de la API REST de Blob Storage, fijada explícitamente (no el default del SDK).
# azure-storage-blob 12.30.0 por defecto usa 2026-06-06, que Azurite 3.33.0 rechaza con
# InvalidHeaderValue. 2025-01-05 es la versión verificada compatible con Azurite 3.33.0 y
# con Azure Storage real. No la quites solo porque el SDK tenga un default más nuevo —
# cambiarla requiere re-verificar compatibilidad con Azurite y con Azure Storage real.
AZURE_STORAGE_API_VERSION=2025-01-05

# Documentos (Fase 16) — contenedor de Blob dedicado, distinto del genérico de
# arriba (least-privilege de alcance de SAS), autoprovisionado de forma
# perezosa en el primer request (documents/router.py), no vía migración.
DOCUMENTS_CONTAINER_NAME=procurawise-documents
DOCUMENTS_MAX_FILE_SIZE_MB=25
DOCUMENTS_DOWNLOAD_URL_TTL_MINUTES=15

# Cola local: InMemoryMessageBus por defecto (ver ADR 0020). No requiere Docker.
QUEUE_BACKEND=memory

# AUTH-PROD (ADR 0003) — JWT propio. El default en config.py es un placeholder
# obviamente inseguro, solo válido fuera de production (el arranque falla si
# se usa en production). En production, generar uno real de >=32 caracteres,
# nunca comitear el valor real.
JWT_SECRET=dev-insecure-jwt-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
PRE_SESSION_TOKEN_TTL_MINUTES=5

# OIDC Microsoft/Google (authlib, ADR 0003). Vacíos en local (el flujo OIDC
# real requiere registrar apps OAuth de prueba, ver docs/development/current-phase.md).
# En production, todos son requeridos.
OIDC_MICROSOFT_CLIENT_ID=
OIDC_MICROSOFT_CLIENT_SECRET=
OIDC_MICROSOFT_TENANT=common
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_REDIRECT_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# Fase 25 (billing/admin, ADR 0025) — Stripe Checkout (mode=payment, compra
# única por-evaluación). Deshabilitado por defecto: sin emulador local de
# Stripe, LocalPaymentProvider atiende todo flujo local/test/CI. Para probar
# contra Stripe real (modo test), ver docs/operations/deployment.md — crear
# la cuenta de prueba, un Product/Price, y ejecutar
# `stripe listen --forward-to localhost:8000/api/v1/billing/stripe/webhook`.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_EVALUATION=
STRIPE_REQUEST_TIMEOUT_SECONDS=20

# Fase 26 (Hardening) — CORS: vacío por defecto (deny-all). Local/CI nunca lo
# necesitan (Vite's proxy hace same-origin), solo cuando el SPA y la API viven
# en orígenes distintos. Comma-separated, ej. https://app.example.com,https://staging.example.com
CORS_ALLOWED_ORIGINS=

# Fase 26 (Hardening) — rate limiting in-process (shared/rate_limit.py, sin
# Redis, ver ADR 0020). Login: (IP, email); IA/billing: por tenant.
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_AI_MAX_REQUESTS=10
RATE_LIMIT_AI_WINDOW_SECONDS=3600
RATE_LIMIT_BILLING_CHECKOUT_MAX_REQUESTS=5
RATE_LIMIT_BILLING_CHECKOUT_WINDOW_SECONDS=3600
